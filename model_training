   "id": "09a1ffe5",
   "metadata": {},
   "source": [
    "# 7. Baseline Multiple Linear Regression\n",
    "\n",
    "A baseline model is fitted before applying corrective transformations. Categorical variables are one-hot encoded with the first category dropped as the reference category."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "f3f3c1e6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Baseline model trained successfully.\n"
     ]
    }
   ],
   "source": [
    "# Baseline preprocessing\n",
    "baseline_preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        (\n",
    "            \"categorical\",\n",
    "            OneHotEncoder(drop=\"first\", handle_unknown=\"ignore\"),\n",
    "            categorical_features\n",
    "        ),\n",
    "        (\n",
    "            \"numerical\",\n",
    "            \"passthrough\",\n",
    "            numeric_features\n",
    "        )\n",
    "    ]\n",
    ")\n",
    "\n",
    "baseline_model = Pipeline(\n",
    "    steps=[\n",
    "        (\"preprocessor\", baseline_preprocessor),\n",
    "        (\"regressor\", LinearRegression())\n",
    "    ]\n",
    ")\n",
    "\n",
    "baseline_model.fit(X_train, y_train)\n",
    "\n",
    "y_train_pred = baseline_model.predict(X_train)\n",
    "y_test_pred = baseline_model.predict(X_test)\n",
    "\n",
    "print(\"Baseline model trained successfully.\")\n"
   ]
