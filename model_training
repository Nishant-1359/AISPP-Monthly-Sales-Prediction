    "    baseline_X_sm\n",
    ").fit()\n",
    "\n",
    "baseline_influence = ols_baseline.get_influence()\n",
    "\n",
    "standardized_residuals = baseline_influence.resid_studentized_internal\n",
    "leverage = baseline_influence.hat_matrix_diag\n",
    "cooks_distance = baseline_influence.cooks_distance[0]\n",
    "\n",
    "influence_analysis = X_train.reset_index(drop=True).copy()\n",
    "influence_analysis[\"Actual\"] = y_train.reset_index(drop=True)\n",
    "influence_analysis[\"Predicted\"] = y_train_pred\n",
    "influence_analysis[\"Residual\"] = residuals_train\n",
    "influence_analysis[\"Standardized_Residual\"] = standardized_residuals\n",
    "influence_analysis[\"Leverage\"] = leverage\n",
    "influence_analysis[\"Cook_Distance\"] = cooks_distance\n",
    "\n",
    "potential_outliers = influence_analysis[\n",
    "    influence_analysis[\"Standardized_Residual\"].abs() > 3\n",
    "]\n",
    "\n",
    "cook_threshold = 4 / len(X_train)\n",
    "\n",
    "potentially_influential = influence_analysis[\n",
    "    influence_analysis[\"Cook_Distance\"] > cook_threshold\n",
    "]\n",
    "\n",
    "print(\"Potential residual outliers:\", len(potential_outliers))\n",
    "print(\"Cook's Distance threshold:\", cook_threshold)\n",
    "print(\"Potentially influential observations:\", len(potentially_influential))\n"
