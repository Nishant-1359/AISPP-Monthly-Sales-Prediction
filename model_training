   "source": [
    "# Log transformation for numerical predictors\n",
    "log_transformer = FunctionTransformer(\n",
    "    np.log1p,\n",
    "    feature_names_out=\"one-to-one\"\n",
    ")\n",
    "\n",
    "final_preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        (\n",
    "            \"categorical\",\n",
    "            OneHotEncoder(drop=\"first\", handle_unknown=\"ignore\"),\n",
    "            final_categorical_features\n",
    "        ),\n",
    "        (\n",
    "            \"numerical_log\",\n",
    "            log_transformer,\n",
    "            final_numeric_features\n",
    "        )\n",
    "    ]\n",
    ")\n",
    "\n",
    "final_regressor = TransformedTargetRegressor(\n",
    "    regressor=LinearRegression(),\n",
    "    func=np.log1p,\n",
    "    inverse_func=np.expm1\n",
    ")\n",
    "\n",
    "final_model = Pipeline(\n",
    "    steps=[\n",
    "        (\"preprocessor\", final_preprocessor),\n",
    "        (\"regressor\", final_regressor)\n",
    "    ]\n",
    ")\n",
    "\n",
    "final_model.fit(X_train_final, y_train)\n",
    "\n",
    "final_train_pred = final_model.predict(X_train_final)\n",
    "final_test_pred = final_model.predict(X_test_final)\n",
    "\n",
    "print(\"Corrected final candidate model fitted successfully.\")\n"
   ]
